  "lines": [
    {
      "who": "小宇",
      "text": "抽球題？送分題啦！十除以六十，六分之一，收工！",
      "file": "01-xiaoyu.wav"
    },
    {
      "who": "老師",
      "text": "小宇，你第三行有看嗎？",
      "file": "02-teacher.wav"
    },
    {
      "who": "小宇",
      "text": "白球放回、紅球不放回……然後呢？",
      "file": "03-xiaoyu.wav"
    },
    {
      "who": "老師",
      "text": "前三十次，紅球已經被抽走四顆了。",
      "file": "04-teacher.wav"
    },
    {
      "who": "小宇",
      "text": "蛤？誠誠老師，那它們去哪了？",
      "file": "05-xiaoyu.wav"
    },
    {
      "who": "老師",
      "text": "抽走就不回來了，跟你的零用錢一樣。",
      "file": "06-teacher.wav"
    },
    {
      "who": "小宇",
      "text": "……所以紅球剩六顆，全部剩五十六顆？",
      "file": "07-xiaoyu.wav"
    },
    {
      "who": "老師",
      "text": "六除以五十六，等於二十八分之三。",
      "file": "08-teacher.wav"
    },
    {
      "who": "小宇",
      "text": "我的分數……跟零用錢一起被抽走了。",
      "file": "09-xiaoyu.wav"
    },
    {
      "who": "老師",
      "text": "你的考卷也有這種陷阱嗎？留言考卷，我們免費幫你抓。",
      "file": "10-teacher.wav"
    }
  ]
}
