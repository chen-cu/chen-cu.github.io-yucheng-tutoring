 "lines": [
  {"who": "小宇", "text": "抽球題？送分題啦！十除以六十，六分之一，收工！", "file": "01-xiaoyu.wav"},
  {"who": "老師", "text": "你第三行有看嗎？", "file": "02-teacher.wav"},
